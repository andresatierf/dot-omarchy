#!/bin/bash

# Bitwarden vault (rbw) driven from the Omarchy menu.
#
#   omarchy-rbw            pick an entry, then an action
#   omarchy-rbw sync       sync the vault
#   omarchy-rbw unlock     unlock the vault
#   omarchy-rbw lock       lock the vault
#   omarchy-rbw status     print unlocked, locked or unavailable
#   omarchy-rbw learn K N  suggest entry N whenever context key K is focused
#   omarchy-rbw forget K   drop what was learned for context key K
#
# The list is ordered by what is on screen: entries whose URIs or names match
# the focused window are offered first, and picking one teaches that pairing.
#
# Secrets never reach argv: values are piped into wl-copy and wtype. Copies are
# marked --sensitive, which makes the Omarchy clipboard plugin skip them
# (shell/plugins/clipboard/capture.sh), and are cleared again after a delay.

set -uo pipefail

CLEAR_AFTER=${OMARCHY_RBW_CLEAR_AFTER:-15}
TYPE_DELAY=${OMARCHY_RBW_TYPE_DELAY:-5}
FOCUS_DELAY=${OMARCHY_RBW_FOCUS_DELAY:-0.3}
MENU_WIDTH=${OMARCHY_RBW_MENU_WIDTH:-700}

I_KEY=$''
I_TYPE=$''
I_COPY=$''
I_TOTP=$''
I_USER=$''
I_FIELDS=$''
I_SYNC=$''
I_NOTE=$''
I_URI=$''
I_HIDDEN=$''

notify() { notify-send -a Passwords -- "$1" "${2-}" >/dev/null 2>&1; }

die() {
  notify "Passwords" "$1"
  exit 1
}

# Selecting nothing is a cancel, not a failure — leave quietly.
menu() {
  local prompt="$1"
  shift
  local selection
  selection=$(printf '%s\n' "$@" | omarchy-menu-select "$prompt" -- --width "$MENU_WIDTH") || return 1
  [[ -z $selection ]] && return 1
  printf '%s' "${selection%%$'\t'*}"
}

# wl-copy forks and serves the selection, so the clearing subshell has to
# outlive this script. It only clears a clipboard still holding our secret.
copy_secret() {
  local value="$1"
  printf '%s' "$value" | wl-copy --sensitive --trim-newline
  (
    sleep "$CLEAR_AFTER"
    [[ $(wl-paste --no-newline 2>/dev/null) == "$value" ]] && wl-copy --clear
  ) >/dev/null 2>&1 &
  disown
}

type_secret() {
  sleep "$FOCUS_DELAY"
  printf '%s' "$1" | wtype -d "$TYPE_DELAY" -
}

mask() {
  local n=${#1}
  ((n > 12)) && n=12
  ((n == 0)) && return
  printf '%*s' "$n" '' | tr ' ' '*'
}

oneline() { printf '%s' "${1//$'\n'/ | }"; }

ensure_unlocked() {
  command -v rbw >/dev/null 2>&1 || die "rbw is not installed"
  rbw unlocked >/dev/null 2>&1 && return
  rbw unlock >/dev/null 2>&1 || die "Vault stayed locked"
}

# Lock state without prompting for anything. Callers that draw a window need
# this before they draw it: the agent's pinentry is an ordinary toplevel, so it
# opens *underneath* a layer-shell overlay and can never be answered.
vault_status() {
  command -v rbw >/dev/null 2>&1 || { printf 'unavailable'; return; }
  if rbw unlocked >/dev/null 2>&1; then printf 'unlocked'; else printf 'locked'; fi
}

# Row composition lives in jq: it sorts by name, picks a glyph from the entry's
# top-level folder, and builds the subtext as "username · folder". It also
# carries `hosts` and `ntok`, which only the context matcher below reads.
# Fields come back unit-separated — a tab would make `read` collapse empty
# leading fields.
ROW_QUERY=$(cat <<'JQ'
def reg($h): ($h | split(".") | if length > 1 then (.[-2] + "." + .[-1]) else (.[0] // "") end);

# Only http(s) URIs describe a site. `androidapp://de.sevenmind.android` is a
# package name, and treating it as a host would invent "sevenmind.android".
def hostof($u):
  ($u | ascii_downcase) as $l
  | if ($l | test("^https?://")) then ($l | sub("^https?://"; ""))
    elif ($l | test("^[a-z0-9][a-z0-9-]*\\.[a-z]{2,}")) then $l
    else "" end
  | if . == "" then "" else
      (split("/") | .[0]) | (split("?") | .[0]) | (split("#") | .[0])
      | (split("@") | .[-1]) | (split(":") | .[0]) | sub("^www\\."; "")
    end;

def hosts:
  ((.uris // []) | map(select(type == "string")) | map(hostof(.))
   | map(select(. != "" and (. | test("\\."))))
   | map(reg(.)) | unique);

def glyph:
  # Keyed on the top-level folder. An unmapped folder just falls back to the
  # key glyph, so reorganising the vault degrades quietly.
  {
    "archive": "", "dev": "", "entertainment": "",
    "family": "", "identity": "", "infra": "",
    "life": "", "misc": "", "money": "",
    "private": "", "security": "", "work": ""
  }[.] // "";

sort_by(.name | ascii_downcase)[]
| (.name // "") as $name
| (.user // "") as $user
| (.folder // "") as $folder
| hosts as $hosts
| ($hosts[0] // "") as $host
# Username first, folder second. Entries with neither fall back to the domain,
# then the item type, so every row keeps a subtext and the list stays even.
| ([$user, $folder] | map(select(. != "")) | join(" · ")) as $sub
| (if $sub != "" then $sub
   elif $host != "" and ($host | ascii_downcase) != ($name | ascii_downcase) then $host
   else (.type // "") end) as $sub
| ($folder | if . == "" then "" else ((split("/") | .[0]) // "") end | glyph) as $glyph
| ($name | ascii_downcase | [scan("[a-z0-9]+")] | map(select(length >= 3)) | unique) as $ntok
| {name: $name, user: $user, folder: $folder, sub: $sub, glyph: $glyph, hosts: $hosts, ntok: $ntok}
JQ
)

# Context matching. Takes the rows above plus $win (the focused window) and
# $assoc (what we have been taught), and returns the rows that belong to
# whatever is on screen. Nothing here touches a secret: it works on entry
# names, folders and URI hosts only.
CONTEXT_QUERY=$(cat <<'JQ'
def lc: ascii_downcase;

# Words that identify nothing: they turn up in half the titles on the machine.
def stop: {
  "the":1,"and":1,"for":1,"with":1,"you":1,"your":1,"new":1,"tab":1,"page":1,
  "log":1,"login":1,"logon":1,"sign":1,"signin":1,"account":1,"accounts":1,
  "home":1,"index":1,"welcome":1,"dashboard":1,"portal":1,"console":1,
  "www":1,"com":1,"net":1,"org":1,"http":1,"https":1,"html":1,"php":1,
  "app":1,"web":1,"online":1,"official":1,"site":1,"website":1,"secure":1,
  "auth":1,"sso":1,"oauth":1,"user":1,"users":1,"profile":1,"settings":1,
  "search":1,"results":1,"loading":1,"untitled":1,"private":1,"browsing":1,
  "browser":1,"window":1,"open":1,"close":1,"menu":1,"file":1,"edit":1,"view":1
};

# A page title says "Gmail" where the vault says "google.com".
def alias: {
  "gmail":["google"],"gdrive":["google"],"gcloud":["google"],"youtube":["google"],
  "outlook":["microsoft","office"],"onedrive":["microsoft"],"teams":["microsoft"],
  "office365":["microsoft","office"],"azure":["microsoft"],
  "aws":["amazon"],"twitter":["x"],"x":["twitter"],
  "icloud":["apple"],"appstore":["apple"]
};

def dedupe: reduce .[] as $t ([]; if index($t) then . else . + [$t] end);

# Title order is kept rather than sorted: a page title puts the site name last
# far more often than first, and the last word is the one worth remembering.
def tokens($s):
  ($s | lc | [scan("[a-z0-9]+")])
  | map(select(length >= 3 and (test("^[0-9]+$") | not)))
  | map(select(stop[.] == null))
  | dedupe;

def domains($s): ($s | lc | [scan("[a-z0-9][a-z0-9-]*\\.[a-z]{2,}(?:\\.[a-z]{2,})?")]);

($win.class // "" | lc)                                   as $class
| ($win.title // "")                                      as $rawtitle
| (["zen","firefox","chrom","brave","vivaldi","librewolf","edge","epiphany","qutebrowser","waterfox","floorp"]
   | any(. as $b | ($class | contains($b))))              as $isbrowser
| (["foot","alacritty","kitty","ghostty","wezterm","xterm","konsole","terminal"]
   | any(. as $b | ($class | contains($b))) and ($isbrowser | not))    as $isterm
# Browsers append their own name; it is never part of the site.
| (if $isbrowser then
     ($rawtitle | sub(" [-—|–] [^-—|–]*(Zen Browser|Firefox|Chromium|Google Chrome|Brave|Vivaldi|LibreWolf|Microsoft.Edge|Chrome)[^-—|–]*$"; ""))
   else $rawtitle end)                                    as $title
# A terminal only says where you are when you are somewhere else: a local
# shell's title is the working directory, which suggests nothing.
| (if $isterm then ($title | [scan("(?:ssh|mosh|sftp)\\s+(?:[a-zA-Z0-9._-]+@)?([a-zA-Z0-9._-]+)")] | flatten) else [] end) as $sshhosts
| ($isterm and ($sshhosts | length) == 0)                 as $mute
| (if $isterm then ($sshhosts | map(lc)) else tokens($title) end)      as $basetok
| ($basetok + ($basetok | map(alias[.] // []) | flatten) | dedupe)     as $wtok
| ((if $isterm then $sshhosts else domains($title) end) | map(lc) | unique) as $wdom
| (if $mute then [] else
     ([$wtok[] | "word:" + .] + [$wdom[] | "domain:" + .]
      + (if $isbrowser then [] else ["app:" + $class] end)) end)       as $keys
| (if $mute then ""
   elif $isterm then ($sshhosts[0] // "" | if . == "" then "" else "word:" + lc end)
   elif $isbrowser then ($basetok[-1] // "" | if . == "" then "" else "word:" + . end)
   else "app:" + $class end)                                           as $primary
| ([$keys[] | $assoc.keys[.].names // []] | flatten | unique)          as $learned
| (if $mute then ""
   elif $isterm then ($sshhosts[0] // $class)
   elif $isbrowser then ($title | sub("^\\s+"; "") | sub("\\s+$"; "") | .[0:44])
   else ($win.class // "") end)                                        as $label
| [ .[]
    | . as $r
    # Taught beats inferred: it was chosen deliberately, over whatever the
    # heuristics had picked at the time.
    | (if ($learned | index($r.name)) then 4
       elif $mute then 0
       elif (($r.hosts // []) | any(. as $h | ($wdom | index($h)))) then 3
       elif (($r.hosts // []) | map(split(".")[0]) | any(. as $b | ($wtok | index($b)))) then 3
       elif (($r.ntok // []) | any(. as $t | ($wtok | index($t)))) then 2
       else 0 end) as $tier
    # Within a tier, an entry whose own name echoes the window wins: on a Gmail
    # tab that is "Bool (Google Workspace)", not every item filed under google.
    | (if (($r.ntok // []) | any(. as $t | ($wtok | index($t)))) then 1 else 0 end) as $echo
    | $r + {tier: $tier, echo: $echo}
  ]                                                                    as $scored
| ([$scored[] | .tier] | max // 0)                                     as $best
| {
    context: {key: $primary, label: $label, muted: $mute},
    # Only the strongest tier is offered. A weak guess costs more than no guess:
    # it takes the top of the list away from what you were going to type.
    suggested: (if $best < 2 then []
                else [$scored[] | select(.tier == $best)]
                     | sort_by(-.echo, (.name | lc)) | .[0:6]
                     | map({name, user, folder, sub, glyph, learned: ($best == 4)})
                end),
    rows: [$scored[] | {name, user, folder, sub, glyph}]
  }
JQ
)

# What Hyprland reports focused. Our overlay is a layer-shell surface rather
# than a toplevel, so it does not become the active window when it takes the
# keyboard; the focus-history fallback is only there in case that ever changes.
active_window() {
  local win
  win=$(hyprctl activewindow -j 2>/dev/null | jq -c '{class: (.class // ""), title: (.title // "")}' 2>/dev/null)
  if [[ -z $win || $win == '{"class":"","title":""}' ]]; then
    win=$(hyprctl clients -j 2>/dev/null |
      jq -c 'sort_by(.focusHistoryID) | .[0] // {} | {class: (.class // ""), title: (.title // "")}' 2>/dev/null)
  fi
  [[ -z $win ]] && win='{"class":"","title":""}'
  printf '%s' "$win"
}

# Learned associations. This holds entry names and the window words they were
# learned from — no credentials — but between them the sites and app names are
# a record of what the vault has logins for, so it is kept private.
ASSOC_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-rbw
ASSOC_FILE=$ASSOC_DIR/associations.json

assoc_read() {
  local raw
  raw=$(jq -c 'if (.version? == 1 and (.keys | type) == "object") then . else {version: 1, keys: {}} end' \
    "$ASSOC_FILE" 2>/dev/null)
  [[ -z $raw ]] && raw='{"version":1,"keys":{}}'
  printf '%s' "$raw"
}

# Re-picking retargets rather than accumulating: a wrong association corrects
# itself the next time you choose. Writes go through a private temp file in the
# same directory, so nothing is ever written through a symlink left at the path.
assoc_write() {
  local key="$1" name="$2" tmp
  [[ -z $key || -z $name ]] && return 0
  mkdir -p -m 700 "$ASSOC_DIR" 2>/dev/null || return 0
  tmp=$(mktemp "$ASSOC_DIR/.assoc.XXXXXX") || return 0
  chmod 600 "$tmp" 2>/dev/null
  if assoc_read | jq -c --arg k "$key" --arg n "$name" --argjson at "$(date +%s)" '
        .keys[$k] = {names: [$n], at: $at}
        # Keep the file bounded; the oldest keys are the ones you stopped using.
        | .keys |= (to_entries | sort_by(-.value.at) | .[0:200] | from_entries)
      ' > "$tmp" 2>/dev/null && [[ -s $tmp ]]; then
    mv -f "$tmp" "$ASSOC_FILE"
  else
    rm -f "$tmp"
  fi
}

assoc_forget() {
  local key="$1" tmp
  [[ -z $key || ! -f $ASSOC_FILE ]] && return 0
  tmp=$(mktemp "$ASSOC_DIR/.assoc.XXXXXX") || return 0
  chmod 600 "$tmp" 2>/dev/null
  if assoc_read | jq -c --arg k "$key" 'del(.keys[$k])' > "$tmp" 2>/dev/null && [[ -s $tmp ]]; then
    mv -f "$tmp" "$ASSOC_FILE"
  else
    rm -f "$tmp"
  fi
}

# The rows, the focused window and what we have been taught, resolved together.
vault_context() {
  rbw list --raw 2>/dev/null | jq -c "$ROW_QUERY" |
    jq -s -c --argjson win "$(active_window)" --argjson assoc "$(assoc_read)" "$CONTEXT_QUERY"
}

pick_entry() {
  local -A seen=()
  local -a options=()
  local name user folder sub glyph key record selection prompt

  CONTEXT=$(vault_context)
  CONTEXT_KEY=$(printf '%s' "$CONTEXT" | jq -r '.context.key // ""' 2>/dev/null)
  # Suggestions are already at the front of the list; the prompt says why.
  prompt=Passwords
  if [[ $(printf '%s' "$CONTEXT" | jq -r '.suggested | length' 2>/dev/null) -gt 0 ]]; then
    prompt="Passwords — $(printf '%s' "$CONTEXT" | jq -r '.context.label // ""' 2>/dev/null)"
  fi

  while IFS=$'\x1f' read -r name user folder sub glyph; do
    [[ -z $name ]] && continue
    key=$name
    [[ -n $sub ]] && key+=$'\t'$sub
    [[ -n ${seen[$key]+x} ]] && continue
    seen[$key]="$folder"$'\x1f'"$name"$'\x1f'"$user"
    if [[ -n $sub ]]; then
      options+=("$glyph"$'\t'"$name"$'\t'"$sub")
    else
      options+=("$glyph"$'\t'"$name")
    fi
  done < <(printf '%s' "$CONTEXT" |
    jq -r '(.suggested + .rows)[] | [.name, .user, .folder, .sub, .glyph] | join("\u001f")' 2>/dev/null)

  ((${#options[@]} == 0)) && die "Vault is empty — try a sync"

  selection=$(printf '%s\n' "${options[@]}" | omarchy-menu-select "$prompt" -- --width "$MENU_WIDTH") || exit 0
  selection=${selection%%$'\n'*}
  [[ -z $selection ]] && exit 0

  record=${seen[$selection]:-}
  [[ -z $record ]] && die "Could not resolve that entry"
  FOLDER=${record%%$'\x1f'*}
  record=${record#*$'\x1f'}
  NAME=${record%%$'\x1f'*}
  USERNAME=${record#*$'\x1f'}

  RBW_ARGS=("$NAME")
  [[ -n $USERNAME ]] && RBW_ARGS+=("$USERNAME")
  [[ -n $FOLDER ]] && RBW_ARGS+=(--folder "$FOLDER")
}

jqe() { printf '%s' "$ENTRY" | jq -r "$1" 2>/dev/null; }

field_value() {
  printf '%s' "$ENTRY" | jq -r --arg n "$1" \
    '[(.fields // [])[]] | map(select(.name == $n)) | .[0].value // empty' 2>/dev/null
}

totp_code() {
  local code
  code=$(rbw code "${RBW_ARGS[@]}" 2>/dev/null) || return 1
  [[ -z $code ]] && return 1
  printf '%s' "$code"
}

# Mirrors the old rbw_details menu: every stored value, with the hidden ones
# masked, each offering copy or type.
browse_fields() {
  local -a labels=() kinds=() values=() options=()
  local seq username password notes uri fname fvalue ftype i

  seq=$(field_value _autotype)
  : "${seq:=username:tab:password}"
  labels+=("Autotype"); kinds+=(autotype); values+=("")
  options+=("$I_TYPE"$'\t'"Autotype"$'\t'"$seq")

  username=$(jqe '.data.username // empty')
  if [[ -n $username ]]; then
    labels+=("Username"); kinds+=(literal); values+=("$username")
    options+=("$I_USER"$'\t'"Username"$'\t'"$username")
  fi

  password=$(jqe '.data.password // empty')
  if [[ -n $password ]]; then
    labels+=("Password"); kinds+=(literal); values+=("$password")
    options+=("$I_KEY"$'\t'"Password"$'\t'"$(mask "$password")")
  fi

  if [[ $(jqe 'if .data.totp then "1" else "" end') == 1 ]]; then
    labels+=("TOTP"); kinds+=(totp); values+=("")
    options+=("$I_TOTP"$'\t'"TOTP"$'\t'"generated on demand")
  fi

  notes=$(jqe '.notes // empty')
  if [[ -n $notes ]]; then
    labels+=("Notes"); kinds+=(literal); values+=("$notes")
    options+=("$I_NOTE"$'\t'"Notes"$'\t'"$(oneline "$notes")")
  fi

  i=1
  while IFS= read -r uri; do
    [[ -z $uri ]] && continue
    labels+=("URI $i"); kinds+=(literal); values+=("$uri")
    options+=("$I_URI"$'\t'"URI $i"$'\t'"$uri")
    ((i++))
  done < <(printf '%s' "$ENTRY" | jq -r '(.data.uris // [])[] | .uri // empty' 2>/dev/null)

  while IFS= read -r ftype && IFS= read -r fname && IFS= read -r fvalue; do
    [[ -z $fname ]] && continue
    labels+=("$fname"); kinds+=(literal); values+=("$fvalue")
    if [[ $ftype == hidden ]]; then
      options+=("$I_HIDDEN"$'\t'"$fname"$'\t'"$(mask "$fvalue")")
    else
      options+=("$I_FIELDS"$'\t'"$fname"$'\t'"$(oneline "$fvalue")")
    fi
  done < <(printf '%s' "$ENTRY" |
    jq -r '(.fields // [])[] | select((.value // "") | length > 0) | (.type // ""), (.name // ""), (.value | gsub("\n"; " | "))' 2>/dev/null)

  local picked
  picked=$(menu "$LABEL" "${options[@]}")

  local idx=-1
  for i in "${!labels[@]}"; do
    [[ ${labels[$i]} == "$picked" ]] && { idx=$i; break; }
  done
  ((idx < 0)) && exit 0

  if [[ ${kinds[$idx]} == autotype ]]; then
    exec omarchy-rbw-autotype "${RBW_ARGS[@]}"
  fi

  local how
  how=$(menu "${labels[$idx]}" \
    "$I_COPY"$'\t'"Copy" \
    "$I_TYPE"$'\t'"Type")

  local value=${values[$idx]}
  if [[ ${kinds[$idx]} == totp ]]; then
    value=$(totp_code) || die "No TOTP for $LABEL"
  fi

  case "$how" in
    Copy) copy_secret "$value"; notify "Copied ${labels[$idx]}" "$LABEL — clears in ${CLEAR_AFTER}s" ;;
    Type) type_secret "$value" ;;
  esac
}

entry_actions() {
  local -a options=()
  local seq username

  seq=$(field_value _autotype)
  : "${seq:=username:tab:password}"
  options+=("$I_TYPE"$'\t'"Autotype"$'\t'"$seq")

  [[ -n $(jqe '.data.password // empty') ]] && options+=(
    "$I_COPY"$'\t'"Copy password"
    "$I_TYPE"$'\t'"Type password"
  )

  username=$(jqe '.data.username // empty')
  [[ -n $username ]] && options+=(
    "$I_COPY"$'\t'"Copy username"$'\t'"$username"
    "$I_TYPE"$'\t'"Type username"$'\t'"$username"
  )

  [[ $(jqe 'if .data.totp then "1" else "" end') == 1 ]] && options+=(
    "$I_COPY"$'\t'"Copy TOTP"
    "$I_TYPE"$'\t'"Type TOTP"
  )

  options+=(
    "$I_FIELDS"$'\t'"Fields"$'\t'"browse everything stored on this entry"
    "$I_SYNC"$'\t'"Sync vault"
  )

  local action value
  action=$(menu "$LABEL" "${options[@]}")

  case "$action" in
    Autotype) run_action autotype ;;
    "Copy password") run_action copy-password ;;
    "Type password") run_action type-password ;;
    "Copy username") run_action copy-username ;;
    "Type username") run_action type-username ;;
    "Copy TOTP") run_action copy-totp ;;
    "Type TOTP") run_action type-totp ;;
    Fields) run_action fields ;;
    "Sync vault") run_action sync ;;
  esac
}

# Every action the picker and the shell plugin can invoke. Expects RBW_ARGS,
# LABEL and ENTRY to be set for the chosen entry.
run_action() {
  local value
  case "$1" in
    autotype) exec omarchy-rbw-autotype "${RBW_ARGS[@]}" ;;
    copy-password)
      value=$(jqe '.data.password // empty')
      [[ -z $value ]] && die "No password on $LABEL"
      copy_secret "$value"; notify "Copied password" "$LABEL — clears in ${CLEAR_AFTER}s" ;;
    type-password)
      value=$(jqe '.data.password // empty')
      [[ -z $value ]] && die "No password on $LABEL"
      type_secret "$value" ;;
    copy-username)
      value=$(jqe '.data.username // empty')
      [[ -z $value ]] && die "No username on $LABEL"
      copy_secret "$value"; notify "Copied username" "$LABEL" ;;
    type-username)
      value=$(jqe '.data.username // empty')
      [[ -z $value ]] && die "No username on $LABEL"
      type_secret "$value" ;;
    copy-totp)
      value=$(totp_code) || die "No TOTP on $LABEL"
      copy_secret "$value"; notify "Copied TOTP" "$LABEL — clears in ${CLEAR_AFTER}s" ;;
    type-totp)
      value=$(totp_code) || die "No TOTP on $LABEL"
      type_secret "$value" ;;
    fields) browse_fields ;;
    sync) sync_vault ;;
    *) die "Unknown action: $1" ;;
  esac
}

sync_vault() {
  ensure_unlocked
  if rbw sync >/dev/null 2>&1; then
    notify "Vault synced"
  else
    die "Sync failed"
  fi
}

# The shell plugin uses `list` to draw its rows and `act` to do the work, so
# every secret stays in this short-lived process and never enters the shell.
case "${1-}" in
  list)
    # Deliberately does not unlock: whoever asked for the list is about to draw
    # it, and unlocking from here would put the prompt behind their window.
    if [[ $(vault_status) != unlocked ]]; then
      printf '{"context":{"key":"","label":"","muted":true},"suggested":[],"rows":[],"locked":true}\n'
      exit 0
    fi
    vault_context
    exit 0 ;;
  status)
    vault_status
    printf '\n'
    exit 0 ;;
  learn)
    assoc_write "${2-}" "${3-}"
    exit 0 ;;
  forget)
    assoc_forget "${2-}"
    exit 0 ;;
  act)
    action=${2-}
    NAME=${3-}
    USERNAME=${4-}
    FOLDER=${5-}
    CONTEXT_KEY=${6-}
    [[ -n $action && -n $NAME ]] ||
      { echo "usage: omarchy-rbw act <action> <name> <user> <folder> [context-key]" >&2; exit 2; }
    # Using an entry while a window is focused is the teaching signal. The key
    # is the one resolved when the list was drawn, so nothing here re-reads a
    # focus that has already moved on.
    [[ $action != sync ]] && assoc_write "$CONTEXT_KEY" "$NAME"
    RBW_ARGS=("$NAME")
    [[ -n $USERNAME ]] && RBW_ARGS+=("$USERNAME")
    [[ -n $FOLDER ]] && RBW_ARGS+=(--folder "$FOLDER")
    LABEL=$NAME
    [[ -n $FOLDER ]] && LABEL="$FOLDER/$NAME"
    if [[ $action != sync ]]; then
      ensure_unlocked
      ENTRY=$(rbw get --raw --full "${RBW_ARGS[@]}" 2>/dev/null) || die "Could not read $LABEL"
      [[ -z $ENTRY ]] && die "Could not read $LABEL"
    fi
    run_action "$action"
    exit 0 ;;
  sync) sync_vault; exit 0 ;;
  lock) rbw lock >/dev/null 2>&1; notify "Vault locked"; exit 0 ;;
  unlock) ensure_unlocked; notify "Vault unlocked"; exit 0 ;;
  ""|pick) ;;
  -h|--help|help)
    sed -n '3,17p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
  *) echo "omarchy-rbw: unknown command '$1'" >&2; exit 2 ;;
esac

ensure_unlocked
pick_entry

LABEL=$NAME
[[ -n $FOLDER ]] && LABEL="$FOLDER/$NAME"

ENTRY=$(rbw get --raw --full "${RBW_ARGS[@]}" 2>/dev/null) || die "Could not read $LABEL"
[[ -z $ENTRY ]] && die "Could not read $LABEL"

assoc_write "${CONTEXT_KEY:-}" "$NAME"

entry_actions
